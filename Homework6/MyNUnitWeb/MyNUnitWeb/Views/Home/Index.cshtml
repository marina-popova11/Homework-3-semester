@{
    ViewData["Title"] = "MyNUnit Web Tester";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        .status-passed { color: green; font-weight: bold; }
        .status-failed { color: red; font-weight: bold; }
        .status-ignored { color: gray; font-weight: bold; }
    </style>
</head>
<body>
    <div class="container mt-4">
        <h2>MyNUnit Web Tester</h2>

        <div class="card mb-4">
            <div class="card-header">
                <h5>Upload Test Assemblies (.dll)</h5>
            </div>
            <div class="card-body">
                <input type="file" id="fileInput" multiple accept=".dll" class="form-control mb-2" />
                <button id="uploadBtn" class="btn btn-primary" disabled>Upload Files</button>
                <button id="runBtn" class="btn btn-success ms-2" disabled>Start Testing</button>
                <div id="uploadStatus" class="mt-2"></div>
            </div>
        </div>

        <div id="latestResult"></div>

        <div class="card mt-4">
            <div class="card-header">
                <h5>Test Run History</h5>
            </div>
            <div class="card-body">
                <div id="historyList">
                    <p>Loading history...</p>
                </div>
            </div>
        </div>
    </div>

    <script>
        let uploadDir = null;

        document.getElementById('fileInput').addEventListener('change', function () {
            document.getElementById('uploadBtn').disabled = this.files.length === 0;
        });

        document.getElementById('uploadBtn').addEventListener('click', async () => {
            const files = document.getElementById('fileInput').files;
            if (files.length === 0) return;

            const formData = new FormData();
            for (let file of files) {
                formData.append('files', file);
            }

            document.getElementById('uploadStatus').innerHTML = '<div class="alert alert-info">Uploading...</div>';

            try {
                const res = await fetch('/home/upload', {
                    method: 'POST',
                    body: formData
                });

                const data = await res.json();
                if (res.ok) {
                    uploadDir = data.uploadDir;
                    document.getElementById('runBtn').disabled = false;
                    document.getElementById('uploadStatus').innerHTML = '<div class="alert alert-success">Files uploaded!</div>';
                } else {
                    throw new Error(data);
                }
            } catch (e) {
                document.getElementById('uploadStatus').innerHTML = `<div class="alert alert-danger">Upload error: ${e.message}</div>`;
            }
        });

        document.getElementById('runBtn').addEventListener('click', async () => {
            if (!uploadDir) return;

            document.getElementById('uploadStatus').innerHTML = '<div class="alert alert-warning">Running tests...</div>';

            try {
                const res = await fetch('/home/run', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ uploadDir })
                });

                const data = await res.json();
                if (res.ok && data.success) {
                    document.getElementById('uploadStatus').innerHTML = '<div class="alert alert-success">Tests completed!</div>';
                    if (data.reports) {
                        showTestResults(data.reports);
                    } else {
                        document.getElementById('latestResult').innerHTML = `<div class="alert alert-info">${data.message || 'No tests were found.'}</div>`;
                    }
                    loadHistory();
                } else {
                    throw new Error(data.message || 'Unknown error');
                }
            } catch (e) {
                document.getElementById('uploadStatus').innerHTML = `<div class="alert alert-danger">Run error: ${e.message}</div>`;
            }
        });

        function showTestResults(reports) {
            if (!reports || !Array.isArray(reports)) {
                document.getElementById('latestResult').innerHTML = '<div class="alert alert-warning">No test reports to display.</div>';
                return;
            }
            let html = '<h4>Latest Test Results</h4>';
            reports.forEach(report => {
                html += `
                    <div class="card mb-3">
                        <div class="card-header">
                            <strong>${report.assemblyName}</strong> |
                            <span class="text-success">✓ ${report.passed}</span> |
                            <span class="text-danger">✗ ${report.failed}</span> |
                            <span class="text-secondary">– ${report.ignored}</span>
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0">
                                <thead><tr>
                                    <th>Class.Method</th>
                                    <th>Status</th>
                                    <th>Time (ms)</th>
                                    <th>Details</th>
                                </tr></thead>
                                <tbody>`;
                report.tests.forEach(test => {
                    let statusClass = '';
                    if (test.status === 'Passed') statusClass = 'status-passed';
                    else if (test.status === 'Failed') statusClass = 'status-failed';
                    else if (test.status === 'Ignored') statusClass = 'status-ignored';

                    let details = test.ignoreReason || test.errorMessage || '';
                    html += `
                        <tr>
                            <td>${test.className}.${test.methodName}</td>
                            <td><span class="${statusClass}">${test.status}</span></td>
                            <td>${test.durationMs.toFixed(2)}</td>
                            <td>${details}</td>
                        </tr>`;
                });
                html += '</tbody></table></div></div>';
            });
            document.getElementById('latestResult').innerHTML = html;
        }

        async function loadHistory() {
            try {
                const res = await fetch('/home/history');
                const runs = await res.json();

                let html = '<div class="list-group">';
                if (runs.length === 0) {
                    html += '<p class="text-muted">No test runs yet.</p>';
                } else {
                    runs.forEach(run => {
                        html += `
                            <div class="list-group-item">
                                <strong>${run.assemblyName}</strong> |
                                <span class="text-success">✓ ${run.passed}</span> |
                                <span class="text-danger">✗ ${run.failed}</span> |
                                <span class="text-secondary">– ${run.ignored}</span>
                            </div>`;
                    });
                }
                html += '</div>';
                document.getElementById('historyList').innerHTML = html;
            } catch (e) {
                document.getElementById('historyList').innerHTML = `<div class="alert alert-danger">Failed to load history: ${e.message}</div>`;
            }
        }

        document.addEventListener('DOMContentLoaded', loadHistory);
    </script>
</body>
</html>